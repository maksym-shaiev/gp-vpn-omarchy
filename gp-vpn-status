#!/usr/bin/env python3
"""gp-vpn-status — status helper for the Omarchy GlobalProtect bar widget.

Prints VPN status as JSON. The reported endpoint ("selected") is resolved in
this order:

  1. The currently ACTIVE endpoint    (a connected tunnel is the ground truth —
                                      toggle/auth always act on the live one)
  2. ~/.config/gp-vpn-omarchy/widget.conf     ENDPOINT=<id>  (widget selector —
                                      decides what "connect" targets when no
                                      tunnel is up)
  3. ~/.config/gp-vpn-omarchy/widget.conf     CONN_NAME=<n> (legacy pin)
  4. DEFAULT_ENDPOINT from ~/.config/smc-gp-vpn/config

The endpoint list comes from ~/.config/smc-gp-vpn/config (ENDPOINTS /
ENDPOINT_<ID>_* keys, written by smc-gp-vpn's install.sh). A legacy
single-endpoint config (PORTAL/CONN_NAME) is treated as one endpoint with
id MAIN; with no config at all the active VPN connection is auto-detected
(needsConfirm: true).

Options:
  --select <id>   Persist the selected endpoint to widget.conf and exit.
  --pin <name>    Legacy: persist a connection name to widget.conf and exit.

Output fields of note:
  state     NM activation state of the selected connection ("activated",
            "activating", "deactivating", …; "" when inactive). Only
            "activated" counts as connected. The selected endpoint prefers
            an activated tunnel, then one that is activating/deactivating.
  refresh   A currently running smc-vpn-refresh ({pid, endpoint, step,
            started}) read from $XDG_RUNTIME_DIR/smc-gp-vpn/refresh.json,
            or null. step "auth" means the browser sign-in phase; later
            steps are plain reconnecting.
  refreshLast  How the last smc-vpn-refresh ended ({pid, endpoint, exit}),
            or null. exit: 0 ok, 130 cancelled, 1 failed.
"""

import ipaddress
import json
import os
import subprocess
import sys
import time

CONFIG_PATH = os.path.expanduser("~/.config/smc-gp-vpn/config")
WIDGET_CONFIG_DIR = os.path.expanduser("~/.config/gp-vpn-omarchy")
WIDGET_CONFIG_PATH = os.path.join(WIDGET_CONFIG_DIR, "widget.conf")
REFRESH_STATE_DIR = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"),
    "smc-gp-vpn",
)
STATE_PATH = os.path.join(REFRESH_STATE_DIR, "refresh.json")
LAST_PATH = os.path.join(REFRESH_STATE_DIR, "refresh-last.json")


def load_config(path: str) -> dict:
    config = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                config[key.strip()] = os.path.expanduser(value.strip())
    except FileNotFoundError:
        pass
    return config


def run(cmd: list[str], check: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, check=check)


def parse_endpoints(config: dict) -> list[dict]:
    """Parse ENDPOINT_* entries from config; fall back to legacy single-endpoint keys.

    Mirrors parse_endpoints() in smc-gp-vpn's scripts. Each endpoint is a dict:
    {id, portal, conn_name, cache}.
    """
    endpoints: list[dict] = []
    for eid in (s.strip().upper() for s in config.get("ENDPOINTS", "").split(",")):
        if not eid or not eid.replace("_", "").isalnum():
            continue
        portal = config.get(f"ENDPOINT_{eid}_PORTAL", "")
        conn = config.get(f"ENDPOINT_{eid}_CONN_NAME", "")
        if not portal or not conn:
            continue
        cache = config.get(
            f"ENDPOINT_{eid}_CACHE",
            os.path.expanduser(f"~/.config/gpclient/smc-cookie-{eid.lower()}.json"),
        )
        endpoints.append({"id": eid, "portal": portal, "conn_name": conn, "cache": cache})

    if endpoints:
        return endpoints

    # Legacy single-endpoint config (written by older install.sh versions).
    portal = config.get("PORTAL", "")
    if portal:
        return [{
            "id": "MAIN",
            "portal": portal,
            "conn_name": config.get("CONN_NAME", "SMC"),
            "cache": config.get(
                "CACHE", os.path.expanduser("~/.config/gpclient/smc-cookie.json")
            ),
        }]
    return []


def default_endpoint(config: dict, endpoints: list[dict]) -> dict | None:
    want = config.get("DEFAULT_ENDPOINT", "").strip().upper()
    for ep in endpoints:
        if ep["id"] == want:
            return ep
    return endpoints[0] if endpoints else None


def active_conns() -> dict[str, str]:
    """Active connections as {name: state}.

    State is NM's activation state as reported by `nmcli connection show
    --active` (lowercase): "activated", "activating", "deactivating", …
    A connection being listed as active does NOT mean the tunnel is up yet —
    `nmcli con up` only removes it from the active list on failure.
    """
    states: dict[str, str] = {}
    out = run(["nmcli", "-t", "-f", "NAME,TYPE,STATE", "connection", "show", "--active"]).stdout
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        rest, _, state = line.rpartition(":")
        name, _, _type = rest.rpartition(":")
        if name:
            states[name] = state.strip().lower()
    return states


def refresh_running() -> dict | None:
    """Currently running smc-vpn-refresh, if its pid is still alive.

    The script writes $XDG_RUNTIME_DIR/smc-gp-vpn/refresh.json
    ({pid, endpoint, connName, step, started, browserLabel}) and removes it
    on exit. A file whose pid is gone (crash) is ignored, not deleted — the
    helper stays read-only. `step` tells the widget which phase is real:
    only "auth" is the browser sign-in; later steps are plain reconnecting.
    `browserLabel` (e.g. "Chrome (stagwellglobal.com)") names the sign-in
    browser for the widget's banner and notification.
    """
    try:
        with open(STATE_PATH) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return None

    pid = data.get("pid", 0)
    if not isinstance(pid, int) or pid <= 0:
        return None
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return None  # stale file from a crashed run
    except PermissionError:
        pass  # pid exists (owned by someone else) — treat as alive
    started = data.get("started", 0)
    if isinstance(started, int) and started > 0 and time.time() - started > 900:
        return None  # absurdly old — treat as stale
    return {
        "pid": pid,
        "endpoint": str(data.get("endpoint", "")),
        "connName": str(data.get("connName", "")),
        "step": str(data.get("step", "")),
        "started": started,
        "browserLabel": str(data.get("browserLabel", "")),
    }


def refresh_last() -> dict | None:
    """How the most recent smc-vpn-refresh ended: {pid, endpoint, exit, error}.

    Written by the script itself just before its state file is removed.
    exit codes: 0 ok, 130 cancelled, 1 failed (then `error` carries the
    script's ERROR: text). Lets the widget report the outcome of sign-ins it
    did not start (no exit signal of its own).
    """
    try:
        with open(LAST_PATH) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict) or not isinstance(data.get("pid"), int):
        return None
    exit_code = data.get("exit", -1)
    out = {
        "pid": data["pid"],
        "endpoint": str(data.get("endpoint", "")),
        "exit": exit_code if isinstance(exit_code, int) else -1,
    }
    err = data.get("error")
    if isinstance(err, str) and err:
        out["error"] = err
    return out


def detect_active_vpn() -> str:
    """Return the first active vpn-type connection, or '' when none."""
    out = run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"]).stdout
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        name, _, type_ = line.rpartition(":")
        if type_ == "vpn":
            return name
    return ""


def write_widget_config(update: dict[str, str]) -> None:
    """Upsert keys into widget.conf, preserving other lines."""
    existing: list[str] = []
    try:
        with open(WIDGET_CONFIG_PATH) as f:
            existing = [line.rstrip("\n") for line in f]
    except FileNotFoundError:
        pass

    out: list[str] = []
    for line in existing:
        key = line.split("=", 1)[0].strip() if "=" in line else ""
        if key in update:
            continue
        out.append(line)
    for key, value in update.items():
        out.append(f"{key}={value}")

    os.makedirs(WIDGET_CONFIG_DIR, exist_ok=True)
    with open(WIDGET_CONFIG_PATH, "w") as f:
        f.write("\n".join(out) + "\n")
    os.chmod(WIDGET_CONFIG_PATH, 0o600)


def pin(conn_name: str) -> None:
    """Legacy: persist connName to the widget's own config (human confirmation)."""
    if not conn_name:
        print(json.dumps({"ok": False, "error": "usage: gp-vpn-status --pin <connName>"}))
        sys.exit(1)
    write_widget_config({"CONN_NAME": conn_name})
    print(json.dumps({"ok": True}))


def select(endpoint_id: str, config: dict) -> None:
    """Persist the selected endpoint id to the widget's own config."""
    endpoints = parse_endpoints(config)
    want = (endpoint_id or "").strip().upper()
    if not want or not any(ep["id"] == want for ep in endpoints):
        known = ", ".join(ep["id"] for ep in endpoints) or "<none configured>"
        print(json.dumps({"ok": False, "error": f"unknown endpoint '{endpoint_id}' (configured: {known})"}))
        sys.exit(1)
    write_widget_config({"ENDPOINT": want})
    print(json.dumps({"ok": True}))


def probe_tunnel() -> tuple[str, str, str, str]:
    """Return (device, ip, gateway, dns) for the first usable tun interface."""
    device = ""
    ip_addr = ""
    gateway = ""
    dns = ""

    links = json.loads(run(["ip", "-j", "link", "show", "type", "tun"]).stdout or "[]")
    for link in links:
        flags = link.get("flags", [])
        if "UP" not in flags:
            continue
        dev = link.get("ifname", "")
        if not dev:
            continue

        addrs = json.loads(run(["ip", "-j", "-4", "addr", "show", "dev", dev]).stdout or "[]")
        if not addrs:
            continue

        for info in addrs[0].get("addr_info", []):
            if info.get("family") != "inet":
                continue
            local = info.get("local", "")
            prefix = info.get("prefixlen")
            if not local or prefix is None:
                continue

            try:
                iface = ipaddress.ip_interface(f"{local}/{prefix}")
                if iface.ip.is_link_local:
                    continue
                # Skip Tailscale's CGNAT range so we don't report tailscale0.
                if iface.network.overlaps(ipaddress.ip_network("100.64.0.0/10")):
                    continue
            except ValueError:
                pass

            device = dev
            ip_addr = f"{local}/{prefix}"
            break

        if device:
            break

    if device:
        dev_info = run(["nmcli", "-t", "-f", "IP4.GATEWAY,IP4.DNS", "device", "show", device]).stdout
        dns_list = []
        for line in dev_info.splitlines():
            if line.startswith("IP4.GATEWAY:"):
                g = line.split(":", 1)[1]
                if g and g != "0.0.0.0":
                    gateway = g
            elif line.startswith("IP4.DNS["):
                dns_list.append(line.split(":", 1)[1])
        dns = ", ".join(dns_list)

    return device, ip_addr, gateway, dns


def main() -> None:
    args = sys.argv[1:]
    config = load_config(CONFIG_PATH)

    if args and args[0] == "--pin":
        pin(args[1] if len(args) > 1 else "")
        return
    if args and args[0] == "--select":
        select(args[1] if len(args) > 1 else "", config)
        return

    widget_config = load_config(WIDGET_CONFIG_PATH)
    conn_states = active_conns()
    endpoints = parse_endpoints(config)

    for ep in endpoints:
        ep["state"] = conn_states.get(ep["conn_name"], "")
        ep["connected"] = ep["state"] == "activated"

    # ── resolve the selected endpoint ────────────────────────────────────────
    # A live or in-flight tunnel is the ground truth: toggle/auth must act on
    # it even if the persisted selection says otherwise. An endpoint that is
    # activating/deactivating (e.g. `nmcli con up` from a terminal) is picked
    # too, so the widget pulses on the connection that is actually changing.
    needs_confirm = False
    selected = next((ep for ep in endpoints if ep["state"] == "activated"), None)
    if selected is None:
        # An endpoint being brought UP wins over one being torn down, so a
        # CLI tunnel switch pulses as "connecting", not "disconnecting".
        selected = next((ep for ep in endpoints if ep["state"] == "activating"), None)
    if selected is None:
        selected = next((ep for ep in endpoints if ep["state"] == "deactivating"), None)

    want_id = widget_config.get("ENDPOINT", "").strip().upper()
    if selected is None and want_id:
        selected = next((ep for ep in endpoints if ep["id"] == want_id), None)

    if selected is None and widget_config.get("CONN_NAME"):
        legacy_name = widget_config["CONN_NAME"]
        selected = next((ep for ep in endpoints if ep["conn_name"] == legacy_name), None)

    if selected is None:
        selected = default_endpoint(config, endpoints)

    if selected is None:
        # No smc-gp-vpn config at all — legacy auto-detect behaviour.
        conn_name = detect_active_vpn()
        needs_confirm = bool(conn_name)
        selected = {"id": "MAIN", "portal": "", "conn_name": conn_name, "cache": ""}

    conn_name = selected["conn_name"]
    state = conn_states.get(conn_name, "")
    connected = state == "activated"

    device = ""
    ip_addr = ""
    gateway = ""
    dns = ""
    since = ""
    since_epoch = 0

    if connected:
        device, ip_addr, gateway, dns = probe_tunnel()

        for line in run(["nmcli", "-t", "-f", "NAME,TIMESTAMP", "connection", "show", "--active"]).stdout.splitlines():
            if line.startswith(conn_name + ":"):
                since_epoch = line.split(":", 1)[1]
                if since_epoch.isdigit():
                    since_epoch = int(since_epoch)
                    since = run(["date", "-Iseconds", "-d", f"@{since_epoch}"]).stdout.strip()
                break

    default_ep = default_endpoint(config, endpoints) if endpoints else selected

    print(
        json.dumps(
            {
                "connected": connected,
                "state": state,
                "portal": selected["portal"],
                "device": device,
                "ip": ip_addr,
                "gateway": gateway,
                "dns": dns,
                "since": since,
                "sinceEpoch": since_epoch,
                "connName": conn_name,
                "needsConfirm": needs_confirm,
                "endpoint": selected["id"],
                "defaultEndpoint": default_ep["id"] if default_ep else "",
                "refresh": refresh_running(),
                "refreshLast": refresh_last(),
                "endpoints": [
                    {
                        "id": ep["id"],
                        "portal": ep["portal"],
                        "connName": ep["conn_name"],
                        "state": ep["state"],
                        "connected": ep["connected"],
                    }
                    for ep in endpoints
                ],
            },
            indent=2,
        )
    )


if __name__ == "__main__":
    main()
