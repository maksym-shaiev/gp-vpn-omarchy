#!/usr/bin/env python3
"""gp-vpn-status — status helper for the Omarchy GlobalProtect bar widget.

Prints VPN status as JSON. The reported endpoint ("selected") is resolved in
this order:

  1. ~/.config/gp-vpn-omarchy/widget.conf     ENDPOINT=<id>  (widget selector)
  2. ~/.config/gp-vpn-omarchy/widget.conf     CONN_NAME=<n> (legacy pin)
  3. The currently active endpoint            (connected right now)
  4. DEFAULT_ENDPOINT from ~/.config/smc-gp-vpn/config

The endpoint list comes from ~/.config/smc-gp-vpn/config (ENDPOINTS /
ENDPOINT_<ID>_* keys, written by smc-gp-vpn's install.sh). A legacy
single-endpoint config (PORTAL/CONN_NAME) is treated as one endpoint with
id MAIN; with no config at all the active VPN connection is auto-detected
(needsConfirm: true).

Options:
  --select <id>   Persist the selected endpoint to widget.conf and exit.
  --pin <name>    Legacy: persist a connection name to widget.conf and exit.
"""

import ipaddress
import json
import os
import subprocess
import sys

CONFIG_PATH = os.path.expanduser("~/.config/smc-gp-vpn/config")
WIDGET_CONFIG_DIR = os.path.expanduser("~/.config/gp-vpn-omarchy")
WIDGET_CONFIG_PATH = os.path.join(WIDGET_CONFIG_DIR, "widget.conf")


def load_config(path: str) -> dict:
    config = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                config[key.strip()] = os.path.expanduser(value.strip())
    except FileNotFoundError:
        pass
    return config


def run(cmd: list[str], check: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, check=check)


def parse_endpoints(config: dict) -> list[dict]:
    """Parse ENDPOINT_* entries from config; fall back to legacy single-endpoint keys.

    Mirrors parse_endpoints() in smc-gp-vpn's scripts. Each endpoint is a dict:
    {id, portal, conn_name, cache}.
    """
    endpoints: list[dict] = []
    for eid in (s.strip().upper() for s in config.get("ENDPOINTS", "").split(",")):
        if not eid or not eid.replace("_", "").isalnum():
            continue
        portal = config.get(f"ENDPOINT_{eid}_PORTAL", "")
        conn = config.get(f"ENDPOINT_{eid}_CONN_NAME", "")
        if not portal or not conn:
            continue
        cache = config.get(
            f"ENDPOINT_{eid}_CACHE",
            os.path.expanduser(f"~/.config/gpclient/smc-cookie-{eid.lower()}.json"),
        )
        endpoints.append({"id": eid, "portal": portal, "conn_name": conn, "cache": cache})

    if endpoints:
        return endpoints

    # Legacy single-endpoint config (written by older install.sh versions).
    portal = config.get("PORTAL", "")
    if portal:
        return [{
            "id": "MAIN",
            "portal": portal,
            "conn_name": config.get("CONN_NAME", "SMC"),
            "cache": config.get(
                "CACHE", os.path.expanduser("~/.config/gpclient/smc-cookie.json")
            ),
        }]
    return []


def default_endpoint(config: dict, endpoints: list[dict]) -> dict | None:
    want = config.get("DEFAULT_ENDPOINT", "").strip().upper()
    for ep in endpoints:
        if ep["id"] == want:
            return ep
    return endpoints[0] if endpoints else None


def active_conn_names() -> list[str]:
    return [
        line.strip()
        for line in run(["nmcli", "-t", "-f", "NAME", "connection", "show", "--active"]).stdout.splitlines()
        if line.strip()
    ]


def detect_active_vpn() -> str:
    """Return the first active vpn-type connection, or '' when none."""
    out = run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"]).stdout
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        name, _, type_ = line.rpartition(":")
        if type_ == "vpn":
            return name
    return ""


def write_widget_config(update: dict[str, str]) -> None:
    """Upsert keys into widget.conf, preserving other lines."""
    existing: list[str] = []
    try:
        with open(WIDGET_CONFIG_PATH) as f:
            existing = [line.rstrip("\n") for line in f]
    except FileNotFoundError:
        pass

    out: list[str] = []
    for line in existing:
        key = line.split("=", 1)[0].strip() if "=" in line else ""
        if key in update:
            continue
        out.append(line)
    for key, value in update.items():
        out.append(f"{key}={value}")

    os.makedirs(WIDGET_CONFIG_DIR, exist_ok=True)
    with open(WIDGET_CONFIG_PATH, "w") as f:
        f.write("\n".join(out) + "\n")
    os.chmod(WIDGET_CONFIG_PATH, 0o600)


def pin(conn_name: str) -> None:
    """Legacy: persist connName to the widget's own config (human confirmation)."""
    if not conn_name:
        print(json.dumps({"ok": False, "error": "usage: gp-vpn-status --pin <connName>"}))
        sys.exit(1)
    write_widget_config({"CONN_NAME": conn_name})
    print(json.dumps({"ok": True}))


def select(endpoint_id: str, config: dict) -> None:
    """Persist the selected endpoint id to the widget's own config."""
    endpoints = parse_endpoints(config)
    want = (endpoint_id or "").strip().upper()
    if not want or not any(ep["id"] == want for ep in endpoints):
        known = ", ".join(ep["id"] for ep in endpoints) or "<none configured>"
        print(json.dumps({"ok": False, "error": f"unknown endpoint '{endpoint_id}' (configured: {known})"}))
        sys.exit(1)
    write_widget_config({"ENDPOINT": want})
    print(json.dumps({"ok": True}))


def probe_tunnel() -> tuple[str, str, str, str]:
    """Return (device, ip, gateway, dns) for the first usable tun interface."""
    device = ""
    ip_addr = ""
    gateway = ""
    dns = ""

    links = json.loads(run(["ip", "-j", "link", "show", "type", "tun"]).stdout or "[]")
    for link in links:
        flags = link.get("flags", [])
        if "UP" not in flags:
            continue
        dev = link.get("ifname", "")
        if not dev:
            continue

        addrs = json.loads(run(["ip", "-j", "-4", "addr", "show", "dev", dev]).stdout or "[]")
        if not addrs:
            continue

        for info in addrs[0].get("addr_info", []):
            if info.get("family") != "inet":
                continue
            local = info.get("local", "")
            prefix = info.get("prefixlen")
            if not local or prefix is None:
                continue

            try:
                iface = ipaddress.ip_interface(f"{local}/{prefix}")
                if iface.ip.is_link_local:
                    continue
                # Skip Tailscale's CGNAT range so we don't report tailscale0.
                if iface.network.overlaps(ipaddress.ip_network("100.64.0.0/10")):
                    continue
            except ValueError:
                pass

            device = dev
            ip_addr = f"{local}/{prefix}"
            break

        if device:
            break

    if device:
        dev_info = run(["nmcli", "-t", "-f", "IP4.GATEWAY,IP4.DNS", "device", "show", device]).stdout
        dns_list = []
        for line in dev_info.splitlines():
            if line.startswith("IP4.GATEWAY:"):
                g = line.split(":", 1)[1]
                if g and g != "0.0.0.0":
                    gateway = g
            elif line.startswith("IP4.DNS["):
                dns_list.append(line.split(":", 1)[1])
        dns = ", ".join(dns_list)

    return device, ip_addr, gateway, dns


def main() -> None:
    args = sys.argv[1:]
    config = load_config(CONFIG_PATH)

    if args and args[0] == "--pin":
        pin(args[1] if len(args) > 1 else "")
        return
    if args and args[0] == "--select":
        select(args[1] if len(args) > 1 else "", config)
        return

    widget_config = load_config(WIDGET_CONFIG_PATH)
    active_names = active_conn_names()
    endpoints = parse_endpoints(config)

    for ep in endpoints:
        ep["connected"] = ep["conn_name"] in active_names

    # ── resolve the selected endpoint ────────────────────────────────────────
    needs_confirm = False
    selected: dict | None = None

    want_id = widget_config.get("ENDPOINT", "").strip().upper()
    if want_id:
        selected = next((ep for ep in endpoints if ep["id"] == want_id), None)

    if selected is None and widget_config.get("CONN_NAME"):
        legacy_name = widget_config["CONN_NAME"]
        selected = next((ep for ep in endpoints if ep["conn_name"] == legacy_name), None)

    if selected is None and endpoints:
        selected = next((ep for ep in endpoints if ep["connected"]), None)
    if selected is None:
        selected = default_endpoint(config, endpoints)

    if selected is None:
        # No smc-gp-vpn config at all — legacy auto-detect behaviour.
        conn_name = detect_active_vpn()
        needs_confirm = bool(conn_name)
        selected = {"id": "MAIN", "portal": "", "conn_name": conn_name, "cache": ""}

    conn_name = selected["conn_name"]
    connected = bool(conn_name) and conn_name in active_names

    device = ""
    ip_addr = ""
    gateway = ""
    dns = ""
    since = ""
    since_epoch = 0

    if connected:
        device, ip_addr, gateway, dns = probe_tunnel()

        for line in run(["nmcli", "-t", "-f", "NAME,TIMESTAMP", "connection", "show", "--active"]).stdout.splitlines():
            if line.startswith(conn_name + ":"):
                since_epoch = line.split(":", 1)[1]
                if since_epoch.isdigit():
                    since_epoch = int(since_epoch)
                    since = run(["date", "-Iseconds", "-d", f"@{since_epoch}"]).stdout.strip()
                break

    default_ep = default_endpoint(config, endpoints) if endpoints else selected

    print(
        json.dumps(
            {
                "connected": connected,
                "portal": selected["portal"],
                "device": device,
                "ip": ip_addr,
                "gateway": gateway,
                "dns": dns,
                "since": since,
                "sinceEpoch": since_epoch,
                "connName": conn_name,
                "needsConfirm": needs_confirm,
                "endpoint": selected["id"],
                "defaultEndpoint": default_ep["id"] if default_ep else "",
                "endpoints": [
                    {
                        "id": ep["id"],
                        "portal": ep["portal"],
                        "connName": ep["conn_name"],
                        "connected": ep["connected"],
                    }
                    for ep in endpoints
                ],
            },
            indent=2,
        )
    )


if __name__ == "__main__":
    main()
